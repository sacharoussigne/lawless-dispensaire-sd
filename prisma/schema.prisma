generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //   url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  bankAccounts  BankAccount[]
  bankAccountAccesses BankAccountAccess[]
  mailTemplates MailTemplate[]
  mails        Mail[]
  uiPreferences UserUiPreferences?
  payrollWeeklyReports PayrollWeeklyReport[]

  @@unique([email])
  @@map("user")
}

enum PayrollWeeklyReportStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
}

model PayrollWeeklyReport {
  id              String                    @id @default(uuid())
  weekStart       DateTime
  weekEnd         DateTime
  status          PayrollWeeklyReportStatus @default(PROCESSING)
  resultJson      Json?
  screenshotKeys  String[]                  @default([])
  errorMessage    String?
  createdById     String
  createdBy       User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([weekStart])
  @@index([createdById])
  @@index([weekStart])
  @@map("payroll_weekly_report")
}

model UserUiPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stock table colors
  lowStockCraftableBg  String   @default("#fff3cd")
  lowStockNormalBg     String   @default("#f8d7da")
  okStockBg            String?
  unknownStockBg       String?

  // Stock row badge "Fait"
  doneTodayBadgeBg     String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("user_ui_preferences")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AppSettings {
  id                           String   @id @default("default")
  dispensaryName               String   @default("Saint-Denis")
  featureStockEnabled          Boolean  @default(true)
  featureBankEnabled           Boolean  @default(true)
  featurePrivatePracticeEnabled Boolean @default(true)
  featureOrdersEnabled         Boolean  @default(true)
  featureSearchEnabled         Boolean  @default(true)
  featureMailsEnabled          Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("app_settings")
}

model CategoryItem {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#ffffff")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  chestStockCheckCategories ChestStockCheckCategory[]

  @@map("category_item")
}

model Item {
  id             String            @id @default(uuid())
  name           String
  description    String?
  minimalQuantity  Int
  isCraftable    Boolean           @default(false)
  isEnabled      Boolean           @default(true)
  canBeSold      Boolean           @default(false)
  price          Decimal?           @db.Decimal(10, 2)
  weight         Float?
  categoryId     String
  category       CategoryItem      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  companyGroupId String?
  companyGroup   CompanyGroup?     @relation(fields: [companyGroupId], references: [id], onDelete: SetNull)
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  stockHistory   StockHistory[]
  craftRecipes   CraftRecipe[]     @relation("CraftedItem")
  usedInRecipes  CraftRecipeItem[] @relation("UsedItem")
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([companyGroupId])
  @@map("item")
}

model Chest {
  id          String         @id @default(uuid())
  name        String
  description String?
  isEnabled   Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  stockHistory StockHistory[]
  stockCheckConfig ChestStockCheckConfig?

  @@map("chest")
}

model ChestStockCheckConfig {
  id        String   @id @default(uuid())
  chestId   String   @unique
  isEnabled Boolean  @default(true)
  chest     Chest    @relation(fields: [chestId], references: [id], onDelete: Cascade)
  categories ChestStockCheckCategory[]

  @@index([chestId])
  @@map("chest_stock_check_config")
}

model ChestStockCheckCategory {
  id        String   @id @default(uuid())
  configId  String
  categoryId String
  config    ChestStockCheckConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  category  CategoryItem          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([configId, categoryId])
  @@index([configId])
  @@index([categoryId])
  @@map("chest_stock_check_category")
}

model StockHistory {
  id        String   @id @default(uuid())
  itemId    String
  chestId   String
  quantity  Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  chest     Chest    @relation(fields: [chestId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@index([itemId])
  @@index([chestId])
  @@index([timestamp])
  @@map("stock_history")
}

model Company {
  id            String                @id @default(uuid())
  name          String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  companyGroups CompanyGroupCompany[]
  orders        Order[]

  @@map("company")
}
model CraftRecipe {
  id                String            @id @default(uuid())
  name              String
  description       String?
  craftedItemId     String
  craftedItem       Item              @relation("CraftedItem", fields: [craftedItemId], references: [id], onDelete: Cascade)
  quantity          Int
  isEnabled         Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  ingredients       CraftRecipeItem[]

  @@index([craftedItemId])
  @@map("craft_recipe")
}
model CraftRecipeItem {
  id            String      @id @default(uuid())
  craftRecipeId String
  craftRecipe   CraftRecipe @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)
  usedItemId    String
  usedItem      Item        @relation("UsedItem", fields: [usedItemId], references: [id], onDelete: Cascade)
  quantity      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([craftRecipeId])
  @@index([usedItemId])
  @@map("craft_recipe_item")
}

model CompanyGroup {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       Item[]
  companies   CompanyGroupCompany[]

  @@map("company_group")
}

model CompanyGroupCompany {
  id             String       @id @default(uuid())
  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyGroupId, companyId])
  @@index([companyGroupId])
  @@index([companyId])
  @@map("company_group_company")
}

enum OrderStatus {
  DRAFT
  LETTER_SENT
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  INCOMING
  OUTGOING
}

model Order {
  id        String       @id @default(uuid())
  name      String
  status    OrderStatus  @default(DRAFT)
  type      OrderType    @default(INCOMING)
  details   String?
  price     Decimal?     @db.Decimal(10, 2)
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     OrderItem[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("order")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, itemId])
  @@index([orderId])
  @@index([itemId])
  @@map("order_item")
}

model MailTemplate {
  id          String                          @id @default(uuid())
  name        String
  description String?
  content     String
  userId      String?
  user        User?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  assignments OrderMailTemplateAssignment[]

  @@index([userId])
  @@map("mail_template")
}

model OrderMailTemplateAssignment {
  id              String         @id @default(uuid())
  orderType       OrderType
  orderStatus     OrderStatus
  mailTemplateId  String
  mailTemplate    MailTemplate @relation(fields: [mailTemplateId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([orderType, orderStatus])
  @@index([mailTemplateId])
  @@index([orderType, orderStatus])
  @@map("order_mail_template_assignment")
}

model Mail {
  id        String   @id @default(uuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  name      String
  receiver  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([createdAt])
  @@map("mail")
}

enum BankAccountAccessType {
  READ
  WRITE
}

model BankAccount {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accesses  BankAccountAccess[]
  weeks     BankAccountWeek[]

  @@index([ownerId])
  @@map("bank_account")
}

model BankAccountAccess {
  id        String   @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType BankAccountAccessType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@map("bank_account_access")
}

model BankAccountWeek {
  id        String   @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  weekStart DateTime // Lundi de la semaine
  weekEnd   DateTime // Dimanche de la semaine
  balance   Decimal  @default(0) @db.Decimal(10, 2) // Solde de fin de semaine
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions BankTransaction[]

  @@unique([accountId, weekStart])
  @@index([accountId])
  @@index([weekStart])
  @@map("bank_account_week")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

model BankTransaction {
  id          String   @id @default(uuid())
  weekId      String
  week        BankAccountWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date        DateTime
  type        TransactionType
  name        String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekId])
  @@index([date])
  @@map("bank_transaction")
}

model TransactionNameSuggestion {
  id        String   @id @default(uuid())
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([value])
  @@map("transaction_name_suggestion")
}

model TransactionDescriptionSuggestion {
  id        String   @id @default(uuid())
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([value])
  @@map("transaction_description_suggestion")
}

model PatientIdentitySuggestion {
  id        String   @id @default(uuid())
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([value])
  @@map("patient_identity_suggestion")
}

model PrivatePracticeWeek {
  id        String   @id @default(uuid())
  weekStart DateTime // Lundi de la semaine
  weekEnd   DateTime // Dimanche de la semaine
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patients  PrivatePracticePatient[]

  @@unique([weekStart])
  @@index([weekStart])
  @@map("private_practice_week")
}

model PrivatePracticePatient {
  id                      String   @id @default(uuid())
  weekId                  String
  week                    PrivatePracticeWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date                    DateTime
  type                    String
  identity                String
  description             String?
  consultationPrice       Decimal  @db.Decimal(10, 2)
  otherPrice              Decimal  @db.Decimal(10, 2)
  amountForCashRegister   Decimal  @db.Decimal(10, 2)
  depositedInCashRegister Boolean  @default(false)
  retrievedFromCashRegister Boolean @default(false)
  order                   Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([weekId])
  @@index([date])
  @@map("private_practice_patient")
}